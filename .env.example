# Database
DATABASE_URL="postgresql://kitespot:kitespot@localhost:5432/kitespot_radar?schema=public"

# App
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
APP_BASE_URL="http://localhost:3000"

# Weather ingestion
WEATHER_API_URL="https://api.open-meteo.com/v1/forecast"
WEATHER_TIMEZONE="Europe/Berlin"
CRON_SECRET="replace-with-a-cron-secret"

# Email notifications
RESEND_API_KEY=""
EMAIL_FROM="KiteSpot Radar <alerts@example.com>"

# Optional map provider. Leaflet works without this using OpenStreetMap tiles.
NEXT_PUBLIC_MAPBOX_TOKEN=""
